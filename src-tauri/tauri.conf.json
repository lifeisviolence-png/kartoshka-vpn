{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "КартошкаVPN",
  "version": "0.9.8",
  "identifier": "ru.kartoshka.vpn",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "КартошкаVPN",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/xray"
    ],
    "resources": {
      "binaries/xray-assets/": "xray-assets/",
      "binaries/licenses/": "licenses/",
      "resources/country-ipv4.bin.gz": "country-ipv4.bin.gz",
      "resources/licenses/DB-IP-LICENSE.txt": "licenses/DB-IP-LICENSE.txt",
      "resources/licenses/flag-icons-LICENSE.txt": "licenses/flag-icons-LICENSE.txt",
      "resources/licenses/Lucide-LICENSE.txt": "licenses/Lucide-LICENSE.txt"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
